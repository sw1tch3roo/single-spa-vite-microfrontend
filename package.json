{
    "name": "example-react-app-module",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "rsbuild dev",
        "build": "rsbuild build",
        "build:dev": "rsbuild build --mode development",
        "preview": "rsbuild preview",
        "lint": "bun lint:ts && bun typecheck && bun lint:css",
        "lint:ts": "bun eslint . --ext ts,tsx",
        "lint:css": "stylelint '**/*.css'",
        "typecheck": "bun tsc --noEmit --project ./tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "fix": "bun fix:ts && bun format",
        "fix:ts": "bun eslint . --ext ts,tsx --fix",
        "fix:css": "stylelint '**/*.css' --fix",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "react-router": "7.8.2"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.6",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.33.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.3.0",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@typescript-eslint/eslint-plugin": "^8.40.0",
        "@typescript-eslint/parser": "^8.40.0",
        "@vitejs/plugin-react-swc": "4.1.0",
        "@vitest/coverage-v8": "3.2.4",
        "@vitest/ui": "3.2.4",
        "eslint": "^9.33.0",
        "eslint-config-mantine": "^4.0.3",
        "eslint-config-next": "15.5.2",
        "eslint-plugin-import-x": "^4.16.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-vitest": "^0.5.4",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "16.1.5",
        "postcss": "^8.5.6",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.6.2",
        "single-spa-react": "^6.0.2",
        "stylelint": "^16.23.1",
        "stylelint-config-standard": "^39.0.0",
        "typescript": "^5.9.2",
        "vitest": "3.2.4"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    }
}
